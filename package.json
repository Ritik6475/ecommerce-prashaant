{
  "name": "elegant-vogue-ecommerce",
  "version": "1.0.0",
  "description": "Full-stack MERN e-commerce clothing store",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
